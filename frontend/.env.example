# MindBridge AI — frontend environment example
#
# Copy this file to `.env` and adjust values for local development.
# `.env` is gitignored — only `.env.example` is committed.

# Base URL of the MindBridge backend, including the /api/v1 prefix.
# Override per environment:
#   - Local dev (this file): http://localhost:8080/api/v1
#   - Staging:                https://staging.mindbridge.example/api/v1
#   - Production:             https://api.mindbridge.example/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1
