# EditorConfig is awesome: https://EditorConfig.org
# Keeps indentation, charset and line endings consistent for a 2-dev team.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java / Maven backend
[*.java]
indent_size = 4
max_line_length = 120

[backend/pom.xml]
indent_size = 4

# YAML (Spring Boot config, GitHub Actions, OpenAPI)
[*.{yml,yaml}]
indent_size = 2

# Markdown: trailing whitespace is often meaningful (line breaks)
[*.md]
trim_trailing_whitespace = false

# SQL (Flyway migrations)
[*.sql]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Windows batch / PowerShell
[*.{bat,ps1}]
end_of_line = crlf