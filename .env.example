# =============================================================
# MindBridge AI — environment variable template
# =============================================================
# Copy this file to `.env` (which is git-ignored) and fill in the
# values for your local environment.
#
# NEVER commit `.env` or any file containing real secret values.
# All variables listed below are required by the eventual backend
# (G1-T02 → G1-T06). Frontend does not read these directly.
# =============================================================

# ----- Database (PostgreSQL) -----
# Format: jdbc:postgresql://HOST:PORT/DBNAME
# Local dev uses `mindbridge_dev` to keep it distinct from any future
# `mindbridge_prod` instance — see backend/README.md § "Database setup".
DATABASE_URL=jdbc:postgresql://localhost:5432/mindbridge_dev
DATABASE_USERNAME=mindbridge_app
DATABASE_PASSWORD=mona32006

# ----- JWT (Spring Security, added in G1-T06) -----
# Use at least 32 random bytes in production. For local dev a
# throwaway value is acceptable, but DO NOT reuse across envs.
JWT_SECRET=replace_me_with_at_least_32_random_bytes
# Token lifetime in seconds (default 1 hour)
JWT_EXPIRATION=3600

# ----- CORS (frontend origin allowed to call the backend) -----
# Comma-separated list. For local dev use http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ----- Dev seed (G2-T09, dev tooling only — never set on prod) -----
# Master switch for the deterministic demo dataset. When true, the seed
# runner loads on startup, removes any prior demo users, and re-seeds
# 15 users × 30 days × 5 daily templates + neutral chat scripts.
# Defaults to false — `mvn spring-boot:run` will NOT seed by default.
# Even with run=true, profile=prod refuses to execute (defense-in-depth).
MINDBRIDGE_SEED_RUN=false
# Scenario: DEFAULT | TRENDING_UP | TRENDING_DOWN. Reserved for upcoming
# tasks; only DEFAULT is implemented in G2-T09.
MINDBRIDGE_SEED_SCENARIO=DEFAULT

# =============================================================
# Real LLM provider (G3-T06) — OPT-IN, defaults keep the mock active
# =============================================================
# Switching to "real" activates the hosted LLM provider (OpenAI per Q1).
# The mock provider is the MVP default; do NOT enable this in CI/tests.
# MINDBRIDGE_AI_PROVIDER=mock
#
# Required when provider=real. The key is dereferenced at request time
# from the env var named by api-key-env-var (default below). NEVER
# inline an API key in this file or anywhere in the repo.
# MINDBRIDGE_AI_REAL_API_KEY=replace_me_with_real_openai_key
#
# Base URL, model name, and per-request timeouts. Defaults are safe for
# OpenAI; tune to your workload.
# MINDBRIDGE_AI_REAL_PROVIDER_LABEL=openai
# MINDBRIDGE_AI_REAL_API_BASE_URL=https://api.openai.com/v1
# MINDBRIDGE_AI_REAL_API_KEY_ENV_VAR=MINDBRIDGE_AI_REAL_API_KEY
# MINDBRIDGE_AI_REAL_MODEL=gpt-4o-mini
# MINDBRIDGE_AI_REAL_MAX_TOKENS=1024
# MINDBRIDGE_AI_REAL_MAX_RETRIES=1
# MINDBRIDGE_AI_REAL_REQUEST_TIMEOUT_MS=20000