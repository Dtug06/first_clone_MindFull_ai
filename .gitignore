# =============================================================
# MindBridge AI — root .gitignore
# Each subproject also has its own .gitignore (frontend/, backend/).
# This file lists patterns that apply across the whole repository.
# =============================================================

# ------------------- Environment & Secrets -------------------
# Real environment files MUST NEVER be committed.
# Only .env.example (with placeholders) is allowed.
.env
.env.*
!.env.example

# ------------------- Backend (Java / Maven) ------------------
# backend/ will be generated in G1-T02. Patterns below prepare
# for Spring Boot so that future commits don't accidentally
# track build output or local configs.
backend/target/
backend/.idea/
backend/*.iml
backend/.vscode/
backend/build/
backend/out/
backend/dependency-reduced-pom.xml
backend/HELP.md

# ------------------- Database & Seed Data --------------------
# database/ and seed-data/ are created in G1-T01 as placeholders.
# Backup files, dumps and local SQL scratchpads must not be tracked.
database/*.bak
database/*.sql~
database/*.dump
seed-data/*.bak
seed-data/local-*.json
seed-data/local-*.csv

# ------------------- Logs ------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/logs/

# ------------------- Tool caches ----------------------------
.vite/
.cache/
.eslintcache
.mypy_cache/
.pytest_cache/
.gradle/
target/

# ------------------- IDE & OS --------------------------------
# IntelliJ / JetBrains
.idea/
*.iml
*.iws
*.ipr

# VS Code (keep .vscode/extensions.json and settings.json if shared)
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json

# Eclipse
.project
.classpath
.settings/
.factorypath

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*

# ------------------- Cursor (agent scratch) ------------------
# Cursor stores local scratch under .cursor/crepe. Keep .cursor/rules
# tracked but ignore local caches.
.cursor/crepe/
.cursor/projects/

# ------------------- Build outputs (generic) -----------------
dist/
build/
out/
*.tsbuildinfo